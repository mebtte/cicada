{
  "compilerOptions": {
    "target": "ESNext",
    "strict": false,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "module": "ESNext",
    "jsx": "react-jsx",
    "lib": ["DOM", "WebWorker", "ESNext", "DOM.Iterable"],
    "types": ["node"],

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "**/node_modules/*"]
}
